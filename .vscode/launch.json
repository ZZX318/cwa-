{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "打开果园场景",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
